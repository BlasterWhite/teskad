{
  "$description": "Teskad design tokens v1. Les valeurs « theme.* » sont sémantiques : l'UI ne doit référencer que celles-là, jamais « brand.* » directement (sauf logo et dégradé).",
  "brand": {
    "violet": "#8A4DFF",
    "magenta": "#E040B0",
    "pink": "#FF6FB0",
    "lavender": "#C9B6FF",
    "plum": "#3A1F4D",
    "gradient": { "from": "#8A4DFF", "to": "#E040B0", "angle": "135deg" }
  },
  "theme": {
    "dark": {
      "bg": "#0E0C12",
      "surface": "#17121E",
      "surfaceRaised": "#1F1828",
      "surfaceSunken": "#0B0A0E",
      "border": "#2A2135",
      "borderStrong": "#3A2F47",
      "text": "#F2EEF7",
      "textSecondary": "#C8BFD4",
      "textMuted": "#A79DB5",
      "accent": "#8A4DFF",
      "accentHover": "#9B66FF",
      "accentPressed": "#7A3DF0",
      "onAccent": "#FFFFFF",
      "accentText": "#A97BFF",
      "focusRing": "#C9B6FF",
      "selectionBg": "#241A33",
      "selectionBorder": "#8A4DFF",
      "hoverOverlay": "rgba(201, 182, 255, 0.06)",
      "scrim": "rgba(8, 6, 12, 0.72)",
      "status": {
        "running": "#A97BFF",
        "completed": "#4FD8A4",
        "failed": "#FF6A55",
        "active": "#C9B6FF",
        "inactive": "#7D7290"
      }
    },
    "light": {
      "bg": "#FAF8FC",
      "surface": "#FFFFFF",
      "surfaceRaised": "#F3EFF8",
      "surfaceSunken": "#F1EDF6",
      "border": "#E6E0EE",
      "borderStrong": "#D2C9DE",
      "text": "#1A1422",
      "textSecondary": "#4A3F58",
      "textMuted": "#6E6380",
      "accent": "#8A4DFF",
      "accentHover": "#7A3DF0",
      "accentPressed": "#6D3BE0",
      "onAccent": "#FFFFFF",
      "accentText": "#5B2FC9",
      "focusRing": "#8A4DFF",
      "selectionBg": "#EFE7FF",
      "selectionBorder": "#8A4DFF",
      "hoverOverlay": "rgba(58, 31, 77, 0.05)",
      "scrim": "rgba(26, 20, 34, 0.40)",
      "status": {
        "running": "#6D3BE0",
        "completed": "#0F7A55",
        "failed": "#C9382A",
        "active": "#7A4FE0",
        "inactive": "#8E84A0"
      }
    }
  },
  "font": {
    "display": "Space Grotesk",
    "ui": "Inter",
    "mono": "JetBrains Mono",
    "fallback": {
      "display": "Inter, system-ui, sans-serif",
      "ui": "system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
    }
  },
  "type": {
    "caption": { "size": 12, "lineHeight": 16, "weight": 500, "font": "ui" },
    "small":   { "size": 13, "lineHeight": 18, "weight": 400, "font": "ui" },
    "body":    { "size": 14, "lineHeight": 20, "weight": 400, "font": "ui" },
    "bodyStrong": { "size": 14, "lineHeight": 20, "weight": 600, "font": "ui" },
    "subtitle": { "size": 16, "lineHeight": 22, "weight": 600, "font": "ui" },
    "title":   { "size": 20, "lineHeight": 26, "weight": 600, "font": "display", "letterSpacing": -0.01 },
    "headline": { "size": 28, "lineHeight": 34, "weight": 600, "font": "display", "letterSpacing": -0.02 },
    "code":    { "size": 13, "lineHeight": 20, "weight": 400, "font": "mono" },
    "label":   { "size": 11, "lineHeight": 14, "weight": 500, "font": "mono", "letterSpacing": 0.06, "uppercase": true }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "pill": 999 },
  "borderWidth": { "default": 1, "focus": 2 },
  "shadow": {
    "dark":  { "popover": "0 8px 24px rgba(0,0,0,0.45), 0 0 0 1px #2A2135", "modal": "0 24px 64px rgba(0,0,0,0.55), 0 0 0 1px #3A2F47" },
    "light": { "popover": "0 8px 24px rgba(26,20,34,0.10), 0 0 0 1px #E6E0EE", "modal": "0 24px 64px rgba(26,20,34,0.16), 0 0 0 1px #D2C9DE" }
  },
  "motion": {
    "fast": 120,
    "base": 180,
    "slow": 280,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "runningPulse": 1400
  },
  "size": {
    "controlSm": 28,
    "controlMd": 32,
    "controlLg": 40,
    "iconSm": 14,
    "iconMd": 16,
    "iconLg": 20,
    "titleBar": 44,
    "sidebar": 248
  }
}
