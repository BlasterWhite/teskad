# The settings of the optional Hangar account's server, for compose.yaml.
# Copy it to hangar-cloud.env beside compose.yaml, readable by its owner only
# (chmod 600), and fill it in. No quotes around the values. A line left empty
# is the same as no line: a provider without its two values is off.
# docs/native/cloud.md, "Deploy", says where each value comes from.

# The GitHub OAuth app. Its callback URL:
#   https://account.hangar.simnjs.fr/v1/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The Google OAuth client (Web application). Its redirect URI:
#   https://account.hangar.simnjs.fr/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How many proxies sit in front of the container:
#   1  Cloudflare only, through a Cloudflare Tunnel (the default)
#   2  Cloudflare, then a reverse proxy on the host (Caddy, Traefik, nginx,
#      a PaaS's router such as Coolify's or Dokploy's)
# HANGAR_CLOUD_TRUSTED_PROXIES=1

# The server's public origin, only when it is not this one. The callback URLs
# above are built from it.
# HANGAR_CLOUD_BASE_URL=https://account.hangar.simnjs.fr
