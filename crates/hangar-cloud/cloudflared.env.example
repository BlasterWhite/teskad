# Only for `docker compose --profile tunnel up -d` (compose.yaml).
# Copy it to cloudflared.env beside compose.yaml (chmod 600).
#
# In Cloudflare: Zero Trust, Networks, Tunnels, Create a tunnel (cloudflared),
# then copy the token of its "docker run" command here. Public hostname:
# account.hangar.simnjs.fr, service HTTP, URL hangar-cloud:8080.
TUNNEL_TOKEN=
